@startuml
left to right direction

actor "Visitor" as Visitor
actor "Learner" as Learner
actor "Kata Author" as Author
actor "Test Runner Service" as Runner <<system>>

rectangle "Codewars platform" {
  usecase "UC-01 Browse kata catalog" as UC01
  usecase "UC-02 View kata details" as UC02
  usecase "UC-03 Submit solution" as UC03
  usecase "UC-04 Evaluate solution" as UC04
  usecase "UC-05 Track attempt status" as UC05
  usecase "UC-06 View rank" as UC06
  usecase "UC-07 Create kata" as UC07
  usecase "UC-08 Retry failed attempt" as UC08
}

Visitor --> UC01
Learner --> UC02
Learner --> UC03
Learner --> UC05
Learner --> UC06
Author --> UC07
Runner --> UC04

UC02 ..> UC01 : <<include>>
UC03 ..> UC02 : <<include>>
UC03 ..> UC04 : <<include>>
UC03 ..> UC05 : <<include>>
UC06 ..> UC04 : <<extend>>
UC08 ..> UC03 : <<extend>>
Author --|> Learner
@enduml
